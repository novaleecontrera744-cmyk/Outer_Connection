# DEMO ONLY: replace every fake credential/address below with your provider values.
# These reserved names/IPs are for documentation and will not make a working tunnel.
VLESS_URL=vless://01234567-89ab-cdef-0123-456789abcdef@edge.example.test:8443?encryption=none&type=tcp&security=reality&flow=xtls-rprx-vision&sni=front.example.test&fp=chrome&pbk=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA&sid=deadbeef&spx=%2F
PROTON_ENDPOINTS=198.51.100.42,203.0.113.18

# Optional. Must match the exact UP WireGuard interface created by Proton.
PROTON_INTERFACE=proton0

# Optional. This TEST-NET address is fake; replace it or remove this line to use 1.1.1.1.
DNS_SERVER=192.0.2.53

# Optional: false allows normal IPv4 via the outer tunnel before Proton connects.
# Set true to block non-Proton traffic throughout startup.
STRICT_MODE=false
